{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "useDefineForClassFields": true,
    "sourceMap": true,
    "paths": {
      "phi-charts": ["./src/index.ts"],
      "phi-charts/trade": ["./src/trade/index.ts"],
      "phi-charts/transform": ["./src/transform/index.ts"],
      "phi-charts/profile": ["./src/profile/index.ts"],
      "phi-charts/indicators": ["./src/indicators/index.ts"],
      "phi-charts/draw": ["./src/draw/index.ts"],
      "phi-charts/webgl": ["./src/webgl/index.ts"],
      "phi-charts/widget": ["./src/widget/index.ts"],
      "phi-charts/workspace": ["./src/workspace/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
